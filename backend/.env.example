# Copy to backend/.env for local runs. In production set these as environment variables / secrets.

# Required: sign login tokens. Generate with: python scripts/generate_secret_key.py
SECRET_KEY=CHANGE_ME_GENERATE_NEW_SECRET_KEY
# Encrypts users' saved API keys. Optional locally (derived from SECRET_KEY); set it in production.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Postgres with pgvector (local: docker compose up -d; online: Neon or Supabase).
# On Neon: DATABASE_URL = the pooled connection string (host contains "-pooler"), DIRECT_URL = the direct one.
DATABASE_URL=postgresql://docai:docai@localhost:5432/docai
DIRECT_URL=postgresql://docai:docai@localhost:5432/docai
# Redis for rate limits and caches (local: docker compose; online: Upstash). Leave empty to use memory.
REDIS_URL=redis://localhost:6379/0

# Server AI model used by free and Pro users. Any OpenAI-compatible API works.
# Local default is Ollama; online e.g. LLM_PROVIDER=openai LLM_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER=ollama
LLM_MODEL=gemma3:latest
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=

# Embeddings for document search (RAG). If this model can't be reached, search falls back to keyword ranking
# (it still works, but finds fewer paraphrases). Online, point it at a hosted embedding model.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=

# Paywall: AI requests per day on the server model (users with their own key are unlimited)
FREE_AI_DAILY_LIMIT=10
PRO_AI_DAILY_LIMIT=500

# Proxies in front of the API whose X-Forwarded-For entry is trusted for rate limits (Cloud Run, Render, Fly: 1).
TRUSTED_PROXY_HOPS=0

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=20
