# =============================================================================
# SENSITIVE DATA - NEVER COMMIT
# =============================================================================

# Environment files with secrets
.env
.env.local
.env.*.local
*.env

# =============================================================================
# USER DATA & DATABASES
# =============================================================================

# Database files
*.db
*.sqlite3
backend/data/chroma_db/
backend/data/sessions/
backend/data/uploads/
backend/data/exports/
backend/documents.db

# Keep the data folder structure but ignore contents
!backend/data/.gitkeep

# =============================================================================
# PYTHON
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
ENV/
env/

# Distribution / packaging
*.egg-info/
dist/
build/
*.egg

# =============================================================================
# NODE.JS
# =============================================================================

# Dependencies
node_modules/
.npm
.yarn

# Build outputs
frontend/dist/
.next/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =============================================================================
# IDE & OS
# =============================================================================

# VS Code
.vscode/
*.code-workspace

# PyCharm / IntelliJ
.idea/

# OS generated
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# =============================================================================
# MISC
# =============================================================================

# Logs
logs/
*.log

# Cache
.cache/
.parcel-cache/

# Test coverage
.coverage
htmlcov/
.pytest_cache/

# Desktop app (Electron) dependencies and built installers
desktop/node_modules/
desktop/release/

