{
  "name": "ai-document-editor-desktop",
  "productName": "AI Document Editor",
  "version": "1.0.0",
  "description": "AI Document Editor for Windows: documents stay on this PC, AI through your account",
  "author": "himanshau",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.himanshau.aidocumenteditor",
    "productName": "AI Document Editor",
    "files": [
      "main.js",
      "status.html",
      "app.config.json",
      "build/icon.png"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "AI-Document-Editor-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "AI-Document-Editor-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "extraResources": [
      {
        "from": "../backend/dist/desktop-server",
        "to": "backend"
      },
      {
        "from": "../frontend/dist-desktop",
        "to": "web"
      }
    ]
  }
}
